#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// | TAB     | Q       | W       | E       | R       | T       |   | Y       | U       | I       | O       | P       | BKSP    |
// | `       | A/SHFT  | S/CTRL  | D/ALT   | F/CMD   | G       |   | H       | J/CMD   | K/ALT   | L/CTRL  | ;/SHFT  | '       |
// | SHFT    | Z       | X       | C       | V       | B       |   | N       | M       | ,       | .       | /       | ESC     |
//                    | ESC/NUM | ENT/UTIL | DEL/CMD  |   | BKSP    | SPC/UTIL | CAPS/NUM |
                        display-name = "Base";
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp GRAVE &mt LSHFT A &mt LCTRL S &mt LALT D &mt LGUI F &kp G   &kp H &mt RGUI J &mt RALT K &mt RCTRL L &mt RSHFT SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &lt 2 ESC &lt 1 RET &mt LGUI DEL      &kp BSPC &lt 1 SPACE &lt 2 CAPS
                        >;
                };

                utility_layer {

// -----------------------------------------------------------------------------------------
// |         |         |         | TAB     |         |         |   | (       | )       | UP      | [       | ]       | -       |
// |         |         |         |         |         |         |   | =       | LEFT    | DOWN    | RIGHT   |         |         |
// | F2      | MISS    | F3      | PREV    | PLAY    | SKIP    |   | CAPC    |         |         |         | VID     | CAP     |
//                    |         |         |         |   |         |         |         |

                        display-name = "Utility";
                        bindings = <
   &trans &trans &trans &kp TAB &trans &trans   &kp LPAR &kp RPAR &kp UP &kp LBKT &kp RBKT &kp MINUS
   &trans &trans &trans &trans &trans &trans   &kp EQUAL &kp LEFT &kp DOWN &kp RIGHT &trans &trans
   &kp F2 &kp LC(UP) &kp F3 &kp C_PREV &kp C_PP &kp C_NEXT   &kp LC(LG(LS(N4))) &trans &trans &trans &kp LG(LS(N5)) &kp LG(LS(N4))
                  &trans &trans &trans      &trans &trans &trans
                        >;
                };

                number_layer {

// -----------------------------------------------------------------------------------------
// |         |         |         |         |         |         |   |         | 7       | 8       | 9       |         |         |
// |         |         |         |         |         |         |   |         | 4       | 5       | 6       |         |         |
// |         |         |         |         |         |         |   | 0       | 1       | 2       | 3       |         |         |
//                    |         |         |         |   |         |         |         |

                        display-name = "Number";
                        bindings = <
   &trans &trans &trans &trans &trans &trans   &trans &kp N7 &kp N8 &kp N9 &trans &trans
   &trans &trans &trans &trans &trans &trans   &trans &kp N4 &kp N5 &kp N6 &trans &trans
   &trans &trans &trans &trans &trans &trans   &kp N0 &kp N1 &kp N2 &kp N3 &trans &trans
                  &trans &trans &trans      &trans &trans &trans
                        >;
                };
        };
};
