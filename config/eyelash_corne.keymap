/*
 * Keymap for the Eyelash Peripherals Corne (eyelash_corne shield).
 *
 * 48-key, 5-row matrix - NOT the 42-key foostan corne. Bindings follow the
 * shield's matrix transform, in this order:
 *
 * row0: TAB      Q    W     E     R     T          UP                   Y       U    I      O     P     BSPC
 * row1: GRAVE    A    S     D     F     G  LEFT ENTER RIGHT    H        J    K      L     SEMI  SQT
 * row2: LSHFT    Z    X     C     V     B  ---- STICK ----   N       M    COMMA  DOT   FSLH  ESC
 * thr:                 LT(2,ESC) LT(1,ENT) MT(CMD,DEL)        BSPC  LT(1,SPC) LT(2,CAPS)
 *
 * Thumb keys (left to right, matching the original corne.keymap):
 *   Left : ESC/NUMBER  ENT/UTILITY  DEL/CMD
 *   Right: BKSP         SPC/UTILITY  CAPS/NUMBER
 * The stick's centre ENTER and the inner keys are MT/MO-free so the six
 * thumb keys above stay where your original map had them.
 *
 * Hardware:
 *   - Thumb scroller: one EC11 encoder on the LEFT half, bound to volume.
 *   - Thumb stick: four ordinary matrix keys (UP/LEFT/RIGHT/DOWN around a
 *     centre ENTER), i.e. the arrow keys. Not a pointing device.
 *
 * Layer numbering: 0 = Base, 1 = Utility, 2 = Number.
 */

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        /*
         * Thumb scroller -> volume.
         * cw-binding is volume up, ccw-binding is volume down.
         * Swap the two if the direction is reversed on your board.
         */
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Hold Q + S + Z for 2 seconds to soft off. */
        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Your original default_layer. */
        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T                               &kp UP                &kp Y        &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp GRAVE  &mt LSHFT A  &mt LCTRL S  &mt LALT D  &mt LGUI F  &kp G   &kp LEFT  &kp ENTER  &kp RIGHT  &kp H        &mt RGUI J  &mt RALT K  &mt RCTRL L  &mt RSHFT SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &trans                 &trans                &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &lt 2 ESC  &lt 1 RET  &mt LGUI DEL                                              &kp BSPC  &lt 1 SPACE  &lt 2 CAPS
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /* Your original utility_layer. */
        utility_layer {
            display-name = "Utility";
            bindings = <
&trans  &trans  &trans  &kp TAB  &trans  &trans                              &trans           &kp LPAR  &kp RPAR  &kp UP   &kp LBKT  &kp RBKT  &kp MINUS
&trans  &trans  &trans  &trans   &trans  &trans          &trans  &trans  &trans  &kp EQUAL &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans
&kp F2  &kp LC(UP)  &kp F3  &kp C_PREV  &kp C_PP  &kp C_NEXT   &trans           &trans           &kp LC(LG(LS(N4)))  &trans  &trans  &trans  &kp LG(LS(N5))  &kp LG(LS(N4))
                        &trans  &trans  &trans                                     &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /* Your original number_layer. */
        number_layer {
            display-name = "Number";
            bindings = <
&trans  &trans  &trans  &trans   &trans  &trans                              &trans          &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans   &trans  &trans          &trans  &trans  &trans  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans   &trans  &trans   &trans          &trans           &kp N0  &kp N1  &kp N2  &kp N3  &trans  &trans
                        &trans  &trans  &trans                                     &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
