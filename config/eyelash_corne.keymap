/*
 * Keymap for the Eyelash Peripherals Corne (eyelash_corne shield).
 *
 * 48-key, 5-row matrix - NOT the 42-key foostan corne. Bindings follow the
 * shield's matrix transform, in this order:
 *
 * row0: TAB      Q    W     E     R     T          UP                   Y       U    I      O     P     BSLH
 * row1: GRAVE    A    S     D     F     G  LEFT ENTER RIGHT    H        J    K      L     SEMI  SQT
 * row2: LSHFT    Z    X     C     V     B  ---- STICK ----   N       M    COMMA  DOT   FSLH  LSHFT
 * thr:                 LT(2,ESC) LT(1,RET) MT(LGUI,DEL)      BSPC  LT(1,SPACE) TD(Opt+Esc/Number)
 *
 * Thumb keys (left to right, matching the original corne.keymap):
 *   Left : ESC/NUMBER  RET/UTILITY  DEL/CMD
 *   Right: BKSP         SPC/UTILITY  Opt+Esc (tap) / NUMBER (hold)
 * The stick's centre click and the inner keys are MT/MO-free so the six
 * thumb keys above stay where your original map had them.
 *
 * Hardware:
 *   - Thumb scroller: one EC11 encoder on the LEFT half, bound to volume.
 *   - Thumb stick: four ordinary matrix keys (UP/LEFT/RIGHT/DOWN around a
 *     centre CLICK), not a pointing device. Base binds macOS shortcuts:
 *     UP Mission Control, DOWN Show Desktop, LEFT Launchpad, RIGHT Caps Lock
 *     toggle, CLICK Spotlight. Utility leaves the stick transparent.
 *
 * Layer numbering: 0 = Base, 1 = Utility, 2 = Number.
 *
 * Hold-taps: `hm` (home mods) and `thumb_lt` / `thumb_lt_own` (left/right thumb
 * layer-taps) use `tapping-term-ms = 140`, `require-prior-idle-ms = 80` and
 * `hold-trigger-on-release`, so a same-hand chord resolves as a hold when the
 * second key is still down after 140 ms, a quick tap stays a tap, and a key
 * pressed within 80 ms of the previous one never resolves to a hold.
 *
 * Number layer, left half:
 *   TAB   -> OUT_USB
 *   Q W E R T -> BT_SEL 0..4
 *   GRAVE -> OUT_BLE
 *   LSHFT -> BT_CLR (clears the currently selected profile)
 */

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off { hold-time-ms = <2000>; };

/* Keymap positions (0-based, the order of the `bindings` arrays):
 * left hand 0-5 / 13-18 / 28-33, right hand 7-12 / 22-27 / 36-41, thumbs 42-47.
 * Combos and `hold-trigger-key-positions` both index these, not matrix cells.
 * LEFT_KEYS is RIGHT_KEYS' complement minus the stick keys 6/19/20/21 and thumbs;
 * 34 and 35 appear in both on purpose (they are neutral cells between the halves).
 */
#define LEFT_KEYS 0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33 34 35
#define RIGHT_KEYS 7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 34 35
#define THUMB_KEYS 42 43 44 45 46 47

/* macOS shortcuts used by the thumb stick and the right thumb. */
#define DESKTOP_SHOW_ALL_APPLICATIONS 0xC02A2
#define DESKTOP_SHOW_ALL_WINDOWS 0xC029E
#define SHOW_ALL_WINDOWS 0xC029F
#define AC_SEARCH 0xC0221

/ {
    behaviors {
        /*
         * hold-preferred + hold-trigger-on-release: a same-hand key still held when
         * tapping-term-ms expires resolves to a hold. tap-preferred can never do
         * this, because same-hand presses are not in hold-trigger-key-positions.
         * The final decision is filtered on release, so tapping the other key
         * within tapping-term-ms still yields two taps.
         *
         * require-prior-idle-ms suppresses holds spelled out at typing speed; keep
         * it below tapping-term-ms, or fast rolls turn home keys into stray mods.
         */
        hm: home_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <140>;
            quick-tap-ms = <140>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_KEYS THUMB_KEYS>;
            hold-trigger-on-release;
        };

        /* Left ESC thumb: hold only triggers from right-hand keys, so the tap stays a tap. */
        thumb_lt: thumb_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <140>;
            quick-tap-ms = <140>;
            require-prior-idle-ms = <80>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <RIGHT_KEYS>;
            hold-trigger-on-release;
        };

        /* Right SPC thumb: hold only triggers from left-hand/thumb keys, so the tap stays a tap. */
        thumb_lt_own: thumb_lt_own {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <140>;
            quick-tap-ms = <140>;
            require-prior-idle-ms = <80>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <LEFT_KEYS THUMB_KEYS>;
            hold-trigger-on-release;
        };

        /* Tap = Opt+Esc. The hold fires on release, so rapid tapping never holds Number. */
        number_caps: number_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LA(ESC)>, <&mo 2>;
        };

        /*
         * Thumb scroller -> volume.
         * cw-binding is volume up, ccw-binding is volume down.
         * Swap the two if the direction is reversed on your board.
         */
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Hold Q + S + Z for 2 seconds to soft off. */
        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Your original default_layer. */
        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T                              &kp DESKTOP_SHOW_ALL_APPLICATIONS  &kp Y        &kp U  &kp I      &kp O    &kp P     &kp BSLH
&kp GRAVE  &hm LSHFT A  &hm LCTRL S  &hm LALT D  &hm LGUI F  &kp G   &kp DESKTOP_SHOW_ALL_WINDOWS  &kp AC_SEARCH  &kp SHOW_ALL_WINDOWS  &kp H        &hm RGUI J  &hm RALT K  &hm RCTRL L  &hm RSHFT SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &trans                 &trans                &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp LSHFT
                         &thumb_lt 2 ESC  &thumb_lt 1 RET  &hm LGUI DEL                                              &kp BSPC  &thumb_lt_own 1 SPACE  &number_caps
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /* Your original utility_layer. */
        utility_layer {
            display-name = "Utility";
            bindings = <
&trans  &trans  &trans  &kp TAB  &trans  &trans                              &trans           &kp LPAR  &kp RPAR  &kp UP   &kp LBKT  &kp RBKT  &kp MINUS
&trans  &trans  &trans  &trans   &trans  &trans          &trans  &trans  &trans  &kp EQUAL &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans
&kp F2  &kp LC(UP)  &kp F3  &kp C_PREV  &kp C_PP  &kp C_NEXT   &trans           &trans           &kp LC(LG(LS(N4)))  &trans  &trans  &trans  &kp LG(LS(N5))  &kp LG(LS(N4))
                        &trans  &trans  &trans                                     &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /* Your original number_layer. */
        number_layer {
            display-name = "Number";
            bindings = <
&out OUT_USB  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans          &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&out OUT_BLE  &trans  &trans  &trans   &trans  &trans          &trans  &trans  &trans  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&bt BT_CLR  &trans  &trans  &trans   &trans  &trans   &trans          &trans           &kp N0  &kp N1  &kp N2  &kp N3  &trans  &trans
                        &trans  &trans  &trans                                     &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
